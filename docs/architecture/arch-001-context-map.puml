@startuml context-map
title Notes Application - DDD Context Map

skinparam componentStyle rectangle
skinparam packageStyle rectangle
left to right direction

package "Notes Management BC" {
    component "Note Aggregate\n(Root: Note)" as Note
}

package "Tag Management BC" {
    component "Tag Aggregate\n(Root: Tag)" as Tag
}

Note ..> Tag : references TagId\n(resolved through application integration)

note bottom of Note
  UC-NOTE-001: Create Note
  UC-NOTE-002: Get Note
  UC-NOTE-003: Rename Note
  UC-NOTE-004: Archive Note
end note

note bottom of Tag
  Future:
  CreateTag
  RenameTag
  DeleteTag
end note

@enduml
