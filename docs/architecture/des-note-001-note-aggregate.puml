@startuml Notes Aggregate
!include theme.puml
title DES-NOTE-001 - Note Aggregate

package "Note Management BC" {

  class Note <<Aggregate Root>> {
    - id: NoteId
    - title: NoteTitle
    - content: String?
    - status: NoteStatus
    --
    + {static} create(title, content): Note
  }

  class NoteId <<Value Object>> {
    + value: UUID
    --
    + {static} generate(): NoteId
  }

  class NoteTitle <<Value Object>> {
    + value: String
    --
    + {static} of(raw): NoteTitle
  }

  enum NoteStatus {
    ACTIVE
    ARCHIVED
    DELETED
  }

  class InvalidTitle <<Domain Error>>

  Note *-- NoteId
  Note *-- NoteTitle
  Note *-- NoteStatus
  NoteTitle ..> InvalidTitle : raises
}

note right of NoteTitle
  Enforces ONT-RULE-NOTE-002
end note

@enduml
