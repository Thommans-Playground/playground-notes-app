@startuml Notes Aggregate
title DES-NOTE-001 - Note Aggregate

skinparam classAttributeIconSize 0

package "Note Management BC" {

  class Note <<Aggregate Root>> {
    - id: NoteId
    - title: NoteTitle
    - content: String?
    - status: NoteStatus
    --
    + create(title, content): Note
  }

  class NoteId <<Value Object>> {
    + value: UUID
  }

  class NoteTitle <<Value Object>> {
    + value: String
  }

  enum NoteStatus {
    ACTIVE
    ARCHIVED
    DELETED
  }

  Note *-- NoteId
  Note *-- NoteTitle
  Note --> NoteStatus
}

note right of NoteTitle
  Enforces ONT-RULE-NOTE-002
end note

@enduml
