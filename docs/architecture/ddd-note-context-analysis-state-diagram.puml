@startuml Analysis of Note Creation
title ANA-NOTE-001: Create Note - Behavioral Analysis

start

:Receive Create Note request;

if (Title contains non-whitespace characters?) then (Yes)
    :Assign unique Note identity;
    :Initialize status as ACTIVE;
    :Preserve title and content;
    :Save Note;

    if (Save successful?) then (Yes)
        :Return created Note ID;
    else (No)
        :Return creation failure;
    endif

else (No)
    :Reject invalid title;
endif

stop
@enduml
