@startuml ANA-NOTE-001
title ANA-NOTE-001 - Create Note Behavioral Analysis

start

:Receive Create Note request;
:Trim surrounding title whitespace;

if (Normalized title empty?) then (Yes)
    :Reject request;
    :Return validation error;
    stop
else (No)
    :Assign unique Note ID;
    :Create Note with ACTIVE status;
    :Preserve normalized title and content;
endif

:Persist Note;

if (Persistence successful?) then (Yes)
    :Return created Note ID;
else (No)
    :Return creation failure;
endif

stop
@enduml
